# variables de infraestructura global.

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL database name
DB_NAME=planazo

# PostgreSQL username
DB_USERNAME=postgres

# PostgreSQL password
# IMPORTANT:
# - Change this value in real environments
# - Never commit real credentials to GitHub
DB_PASSWORD=change_me


# =============================================================================
# Container Ports
# =============================================================================

# External port exposed by PostgreSQL container
DB_EXTERNAL_PORT=5432

# External port exposed by backend container
BACKEND_EXTERNAL_PORT=8080

# External port exposed by web-auth container
WEB_AUTH_EXTERNAL_PORT=5173

# External port exposed by Adminer
ADMINER_EXTERNAL_PORT=8082


# =============================================================================
# Docker Volumes
# =============================================================================

# Base directory used for persistent Docker volumes
VOLUME_DIR=.docker
