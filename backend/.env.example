# variables privadas del backend.

# =============================================================================
# JWT Configuration
# =============================================================================

# Secret used to sign JWT access tokens
# Generate a strong random secret in real environments
JWT_ACCESS_SECRET=replace_with_secure_secret


# =============================================================================
# Email / Resend Configuration
# =============================================================================

# Resend API key used for transactional emails
RESEND_API_KEY=replace_with_resend_api_key


# =============================================================================
# Web Auth Configuration
# =============================================================================

# Public URL used in email verification / password reset links
WEB_AUTH_URL=http://your_local_IP:5173
