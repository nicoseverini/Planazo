# variables privadas del backend.

# =============================================================================
# JWT Configuration
# =============================================================================

# Secret used to sign JWT access tokens
# Generate a strong random secret in real environments
JWT_ACCESS_SECRET=replace_with_secure_secret


# =============================================================================
# Email Configuration
# =============================================================================

SMTP_USERNAME=gmail@gmail.com
SMTP_PASSWORD=service password

# =============================================================================
# Web Auth Configuration
# =============================================================================

# Public URL used in email verification / password reset links
WEB_AUTH_URL=http://your_local_IP:5173

# =============================================================================
# Admin Account Bootstrap
# =============================================================================

ADMIN_EMAIL=admin@planazo.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
ADMIN_LASTNAME=Account
ADMIN_GENDER=Other
ADMIN_PHOTO=A
ADMIN_BIRTH_DATE=2000-01-01

# =============================================================================
# Gemini API Configuration (for text translation)
# =============================================================================

GEMINI_API_KEY=replace_with_your_key
GEMINI_API_URL=replace_with_your_url

# =============================================================================
# Geocoding Configuration (OpenStreetMap / Nominatim)
# =============================================================================
# Only GEOCODING_API_URL have sensible defaults in application.properties. Override the
# URL to point to a self-hosted Nominatim instance, and set a User-Agent that
# identifies your deployment (required by Nominatim's usage policy).

GEOCODING_API_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=replace_with_your_user_agent

